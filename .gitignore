# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
*.egg-info/
dist/
build/
*.egg

# Virtual environments
venv/
env/
.env/

# Secrets — API keys (e.g. OPENTOPOGRAPHY_API_KEY) belong in the environment,
# never in the repo. Covers a .env FILE, which the .env/ rule above does not.
.env
.env.*
*.env
secrets.json

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Data (large files — user provides)
data/TIF_files/
*.tif
*.npz

# Figures (generated)
figures/*.png
figures/*.pdf
figures/*.svg

# OpenMDAO output directories
demo_mdao*_out/
demo_mdao_out/
*.openmdao_out
.openmdao/
*_out/

# Scratch / debug scripts
scratch/

# Workspace files
*.code-workspace

# OpenMDAO auto-generated report directories
reports/*_out/

# Stale virtualenvs / scratch work
HybridRaptor/

# ── Generated artifacts that are cheap to rebuild ────────────────────────
# The DEM is a cache: one OpenTopography call and ~13 s rebuilds it, and the
# .npz files run to megabytes each. Keeping them out means the repo carries
# the recipe rather than the result, and nobody pulls 12 MB of terrain they
# will re-fetch anyway. Rebuild:
#   python -m hpraptor.m1_mission.srtm_downloader --mission configs/<x>.yaml
data/dem/

# The interactive 3D pages embed the whole scene as base64 VTK -- 6-13 MB
# each. The static plates next to them are committed; regenerate these with
#   python -m hpraptor.postprocessing.trajectory_3d --interactive
reports/*_interactive.html
reports/*.vts
reports/*.vtp

# ── The manuscript stays private ─────────────────────────────────────────
# paper/ holds the journal draft, its LaTeX sources, the audit scripts that
# produce its numbers, and the built PDFs. It is deliberately NOT tracked:
# the repository is where the framework lives, not the manuscript, and an
# unpublished draft should not be pushed anywhere. Nothing under paper/ has
# ever been committed to this repository -- keep it that way.
#
# Everything in it is reproducible from the framework: paper/audit/*.py
# regenerate the JSON results and the figures, and paper/build_papers.py
# rebuilds both PDFs.
paper/
